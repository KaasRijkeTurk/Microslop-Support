# ⚠️ Copy this file to .env and fill in your own values

# Discord Bot Token (get it from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Minecraft Server IP/Hostname
MC_HOST=your_mc_server_ip_here

# Minecraft Server Port (default: 25565)
MC_PORT=25565

# Minecraft Query Port (default: 25565)
MC_QUERY_PORT=25565

# Minecraft RCON Port (default: 25575)
MC_RCON_PORT=25575

# RCON Password
MC_RCON_PASSWORD=your_rcon_password_here

# Path to your Minecraft server folder (where server.properties is located)
MC_SERVER_PATH=./ctserver

# IP address users should use to join your server
MC_JOIN_IP=your_server_join_ip_here

# RCON Admin Password (used for .mcrcon command in Discord)
MC_RCON_ADMIN_PASSWORD=your_rcon_admin_password_here

# Password for .setup command in Discord
SETUP_PASSWORD=your_setup_password_here
